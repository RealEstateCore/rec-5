  "dependencies": {
    "commander": "^14.0.3",
    "n3": "^2.0.3"
  },
  "devDependencies": {
    "@types/n3": "^1.26.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
