{
  "name": "rec-to-dtdl",
  "version": "0.1.0",
  "description": "Convert REC OWL/SHACL Turtle ontology to DTDL models",
  "type": "module",
  "bin": {
    "rec-to-dtdl": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "convert": "tsx src/cli.ts -o ../dtdl-output ../ontology/rec-ontology-configured.ttl"
  },
  "keywords": [],
  "author": "",
