rec:sourcePoint
    a owl:ObjectProperty;
    rdfs:comment
        "The brick:Point that emitted this exception."@en,
        "The brick:Point that emitted this observation."@en;
    rdfs:label "source point"@en, "source point"@sv;
    rdfs:subPropertyOf rec:relationship.
rec:sourcePointShape
    a sh:PropertyShape;
    sh:class brick:Point;
    sh:maxCount 1;
    sh:message
        "Property sourcePoint must reference a valid instance of Point. Can have at most one sourcePoint"@en;
    sh:path rec:sourcePoint.
rec:Space
    a owl:Class, sh:NodeShape;
    rdfs:comment
        "A contiguous part of the physical world that contains or can contain sub-spaces. E.g., a Region can contain many Sites, which in turn can contain many Buildings."@en;
    rdfs:label "Space"@en, "Space"@sv;
    rdfs:subClassOf rec:Entity;
    sh:property
        rec:geometryShape, rec:georeferenceShape, rec:hasIdentifierShape,
        rec:hasPartShape, rec:isLocationOfShape, rec:isPartOfShape,
        rec:nameShape.
