    rdfs:label "Office"@en, "Office"@sv;
    rdfs:subClassOf rec:Room.
rec:OfficeChair
    a owl:Class, sh:NodeShape;
    rdfs:label "Office chair"@en, "Office chair"@sv;
    rdfs:subClassOf rec:Chair.
rec:OfficeLandscape
    a owl:Class, sh:NodeShape;
    rdfs:label "OfficeLandscape"@en, "OfficeLandscape"@sv;
    rdfs:subClassOf rec:Office.
rec:OfficeRoom
    a owl:Class, sh:NodeShape;
    rdfs:label "OfficeRoom"@en, "OfficeRoom"@sv;
    rdfs:subClassOf rec:Office.
rec:operatedBy
    a owl:ObjectProperty;
    rdfs:label "operated by"@en, "operated by"@sv;
    rdfs:subPropertyOf rec:relationship.
rec:operatedByShape
    a sh:PropertyShape;
    sh:class rec:Agent;
    sh:message
    "Property operatedBy must reference a valid instance of Agent"@en;
    sh:path rec:operatedBy.
rec:OperatingRoom
    a owl:Class, sh:NodeShape;
    rdfs:label "Operating room"@en, "Operating room"@sv;
    rdfs:subClassOf rec:HealthcareRoom.
rec:Organization
    a owl:Class, sh:NodeShape;
    rdfs:comment
        "An organization of any sort (e.g., a business, association, project, consortium, tribe, etc.)"@en;
    rdfs:label "Organization"@en, "Organization"@sv;
    rdfs:subClassOf rec:Agent;
    sh:property
    rec:hasMemberShape, rec:hasPartShape, rec:isPartOfShape, rec:logoShape.
rec:originX
    a owl:DatatypeProperty;
    rdfs:label "origin x"@en, "origin x"@sv;
    rdfs:range xsd:double.
rec:originXShape a sh:PropertyShape; sh:datatype xsd:double; sh:path rec:originX.

rec:originY
    a owl:DatatypeProperty;
    rdfs:label "origin y"@en, "origin y"@sv;
    rdfs:range xsd:double.
rec:originYShape a sh:PropertyShape; sh:datatype xsd:double; sh:path rec:originY.

rec:OutdoorSpace
    a owl:Class, sh:NodeShape;
    rdfs:label "Outdoor space"@en, "Outdoor space"@sv;
    rdfs:subClassOf rec:Architecture.
rec:OutpatientServicesRoom
    a owl:Class, sh:NodeShape;
    rdfs:label "Outpatient services room"@en, "Outpatient services room"@sv;
    rdfs:subClassOf rec:HealthcareRoom.
rec:ownedBy
    a owl:ObjectProperty;
    rdfs:label "owned by"@en, "owned by"@sv;
    rdfs:subPropertyOf rec:relationship.
rec:ownedByShape
    a sh:PropertyShape;
    sh:class rec:Agent;
    sh:message "Property ownedBy must reference a valid instance of Agent"@en;
    sh:path rec:ownedBy.
rec:owns
    a owl:ObjectProperty;
    rdfs:comment
        "Indicates ownership of some thing, e.g., a building, an asset, an organization, etc."@en;
    rdfs:label "owns"@en, "owns"@sv;
    rdfs:subPropertyOf rec:relationship.
rec:ownsShape a sh:PropertyShape; sh:path rec:owns.

rec:Pantry
    a owl:Class, sh:NodeShape;
    rdfs:label "Pantry"@en, "Pantry"@sv;
    rdfs:subClassOf rec:FoodHandlingRoom.
rec:ParkingSpace
    a owl:Class, sh:NodeShape;
    rdfs:label "Parking space"@en, "Parking space"@sv;
    rdfs:subClassOf rec:Zone.
rec:Partition
    a owl:Class, sh:NodeShape;
    rdfs:label "Partition"@en, "Partition"@sv;
    rdfs:subClassOf rec:BarrierAsset.
rec:Person
    a owl:Class, sh:NodeShape;
    rdfs:comment "A natural person (i.e., an individual human being)."@en;
    rdfs:label "Person"@en, "Person"@sv;
    rdfs:subClassOf rec:Agent;
    sh:property
    rec:familyNameShape, rec:genderShape, rec:givenNameShape, rec:imageShape.
rec:PersonalHygiene
    a owl:Class, sh:NodeShape;
    rdfs:label "Personal hygiene room"@en, "Personal hygiene room"@sv;
    rdfs:subClassOf rec:Room.
rec:PharmacyRoom
    a owl:Class, sh:NodeShape;
    rdfs:label "Pharmacy room"@en, "Pharmacy room"@sv;
    rdfs:subClassOf rec:HealthcareRoom.
rec:PhoneBooth
    a owl:Class, sh:NodeShape;
    rdfs:label "PhoneBooth"@en, "PhoneBooth"@sv;
    rdfs:subClassOf rec:Office.
rec:Point
    a owl:Class, sh:NodeShape;
    rdfs:label "Point"@en, "Point"@sv;
    rdfs:subClassOf rec:Geometry;
    sh:property rec:coordinatesShape.
rec:PointEvent
    a owl:Class, sh:NodeShape;
    rdfs:comment
        "An event emanating from or targeting a Point; e.g., an individual Observation from a Sensor point, or an Actuation sent to a Command point. In other terms, the Points indicate the capability of some Space or Equipment to emit or accept data, while this class represents those actual data messages. Note that in most non-trivially sized systems, these events are not stored in the knowledge graph itself, but are rather forwarded to some C&C system or time series database."@en;
    rdfs:label "Point event"@en, "Point event"@sv;
    rdfs:subClassOf rec:Event.
rec:PointOfInterest
    a owl:Class, sh:NodeShape;
    rdfs:label "Point of Interest"@en, "Point of Interest"@sv;
    rdfs:subClassOf rec:Information;
    sh:property rec:objectOfInterestShape.
rec:Polygon
    a owl:Class, sh:NodeShape;
    rdfs:label "Polygon"@en, "Polygon"@sv;
    rdfs:subClassOf rec:Geometry;
    sh:property rec:coordinatesShape.
rec:Portfolio
    a owl:Class, sh:NodeShape;
    rdfs:comment
        "A portfolio is a grouping of buildings, sites, apartments, campuses, etc. that share some business-relevant commonality, e.g., are managed by the same company, are rented out to the same tenant, share utilization or legal definition (industrial vs commercial), etc."@en;
    rdfs:label "Portfolio"@en, "Portfolio"@sv;
    rdfs:subClassOf rec:Collection;
    sh:property rec:includesShape.
rec:PostalAddress
    a owl:Class, sh:NodeShape;
    rdfs:label "Postal address"@en, "Postal address"@sv;
    rdfs:subClassOf rec:Information;
    sh:property
        rec:addressLine1Shape, rec:addressLine2Shape, rec:cityShape,
        rec:countryShape, rec:postalCodeShape, rec:regionShape.
rec:postalCode
    a owl:DatatypeProperty;
    rdfs:label "postal code"@en, "postal code"@sv;
    rdfs:range xsd:string.
rec:postalCodeShape
a sh:PropertyShape; sh:datatype xsd:string; sh:path rec:postalCode.
rec:Premises
    a owl:Class, sh:NodeShape;
    rdfs:comment
        "A premises is an administrative grouping of spaces that are used for some commercial or industrial purpose by a real estate holder or tenant. E.g, a suite of offices, a shop, or an industrial workshop."@en;
    rdfs:label "Premises"@en, "Premises"@sv;
    rdfs:subClassOf rec:Collection;
    sh:property rec:includesShape.
rec:PrinterCart
    a owl:Class, sh:NodeShape;
    rdfs:label "Printer cart"@en, "Printer cart"@sv;
    rdfs:subClassOf rec:Cart.
rec:PrinterStand
    a owl:Class, sh:NodeShape;
    rdfs:label "Printer stand"@en, "Printer stand"@sv;
    rdfs:subClassOf rec:Stand.
rec:producedBy
    a owl:ObjectProperty;
    rdfs:label "produced by"@en, "produced by"@sv;
    rdfs:subPropertyOf rec:relationship.
rec:producedByShape
    a sh:PropertyShape;
    sh:class brick:Point;
    sh:message
    "Property producedBy must reference a valid instance of Point"@en;
    sh:path rec:producedBy.
rec:RadiologyRoom
    a owl:Class, sh:NodeShape;
    rdfs:label "Radiology room"@en, "Radiology room"@sv;
    rdfs:subClassOf rec:HealthcareRoom.
rec:RealEstate
    a owl:Class, sh:NodeShape;
    rdfs:comment
        """The legal/administrative representation of some lands and/or buildings. I.e., "Fastighet" (Swedish), "Ejendom" (Denmark), etc."""@en;
    rdfs:label "Real Estate"@en, "Real Estate"@sv;
    rdfs:subClassOf rec:Collection;
    sh:property rec:includesShape.
rec:Reception
    a owl:Class, sh:NodeShape;
    rdfs:label "Reception"@en, "Reception"@sv;
    rdfs:subClassOf rec:Room.
rec:ReceptionTable
    a owl:Class, sh:NodeShape;
    rdfs:label "Reception table"@en, "Reception table"@sv;
    rdfs:subClassOf rec:Table.
rec:RecordingRoom
    a owl:Class, sh:NodeShape;
    rdfs:label "Recording room"@en, "Recording room"@sv;
    rdfs:subClassOf rec:Room.
rec:RecreationalRoom
    a owl:Class, sh:NodeShape;
    rdfs:label "Recreational room"@en, "Recreational room"@sv;
    rdfs:subClassOf rec:Room.
rec:region
    a owl:DatatypeProperty;
    rdfs:label "region"@en, "region"@sv;
    rdfs:range xsd:string.
rec:Region
    a owl:Class, sh:NodeShape;
    rdfs:comment
        """An administrative geospatial unit larger than the individual real estate. For instance, "Lombary", "North America", "The Back Bay", "Elnätsområde Syd", etc."""@en;
    rdfs:label "Region"@en, "Region"@sv;
    rdfs:subClassOf rec:Space.
rec:regionShape a sh:PropertyShape; sh:datatype xsd:string; sh:path rec:region.

rec:regulatedBy
    a owl:ObjectProperty;
    rdfs:comment
    "Indicates the contract regulating the terms of the lease in question. "@en;
    rdfs:label "regulated by"@en, "regulated by"@sv;
    rdfs:subPropertyOf rec:relationship.
rec:regulatedByShape
    a sh:PropertyShape;
    sh:class rec:LeaseContract;
    sh:message
    "Property regulatedBy must reference a valid instance of LeaseContract"@en;
    sh:path rec:regulatedBy.
rec:regulates
    a owl:ObjectProperty;
    rdfs:comment
    "Indicates the lease(s) that this contract regulates the conditions of."@en;
    rdfs:label "regulates"@en, "regulates"@sv;
    rdfs:subPropertyOf rec:relationship.
rec:regulatesShape
    a sh:PropertyShape;
    sh:class rec:Lease;
    sh:message "Property regulates must reference a valid instance of Lease"@en;
    sh:path rec:regulates.
rec:relatedTo
    a owl:ObjectProperty;
    rdfs:label "related to"@en, "related to"@sv;
    rdfs:subPropertyOf rec:relationship.
rec:relatedToShape a sh:PropertyShape; sh:path rec:relatedTo.

rec:relationship
    a owl:ObjectProperty;
    rdfs:comment
    "All REC relationships will be sub properties of rec:relationship"@en;
    rdfs:label "relationship"@en, "relationship"@sv.
