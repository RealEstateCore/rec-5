rec:hasPart
    a owl:AsymmetricProperty, owl:IrreflexiveProperty, owl:ObjectProperty;
    rdfs:comment
        "Indicates parthood relations in organizations (e.g., departments of a corporation). Note that membership in an organization is expressed using the more specific hasMember property."@en;
    rdfs:label "has part"@en, "has part"@sv;
    rdfs:subPropertyOf rec:relationship.
rec:hasPartShape
