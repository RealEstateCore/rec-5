    rdfs:label "start level"@en, "start level"@sv;
    rdfs:range xsd:string.
rec:startLevelShape
a sh:PropertyShape; sh:datatype xsd:string; sh:path rec:startLevel.
rec:startShape a sh:PropertyShape; sh:datatype xsd:dateTime; sh:path rec:start.

