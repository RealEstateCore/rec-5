    rdfs:range xsd:double.
rec:xRotationalScaleFactorShape
a sh:PropertyShape; sh:datatype xsd:double; sh:path rec:xRotationalScaleFactor.
rec:yRotationalScaleFactor
    a owl:DatatypeProperty;
