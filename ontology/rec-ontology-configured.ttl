    a owl:Class, sh:NodeShape;
    rdfs:label "Sprinkler room"@en, "Sprinkler room"@sv;
    rdfs:subClassOf rec:UtilitiesRoom.
rec:Stadium
    a owl:Class, sh:NodeShape;
    rdfs:label "Stadium"@en, "Stadium"@sv;
    rdfs:subClassOf rec:Building.
rec:StaffRoom
    a owl:Class, sh:NodeShape;
