rec:Architecture
    a owl:Class, sh:NodeShape;
    rdfs:comment
        "A designed/landscaped (or potentially designed/landscaped) part of the physical world that has a 3D spatial extent. E.g., a building site, a building, levels within the building, rooms, etc."@en;
    rdfs:label "Architecture"@en, "Architecture"@sv;
    rdfs:subClassOf rec:Space;
    sh:property
        rec:addressShape, rec:adjacentElementShape, rec:architectedByShape,
        rec:constructedByShape, rec:containsElementShape,
        rec:documentationShape, rec:hasAreaShape, rec:hasCapacityShape,
        rec:hasPointShape, rec:intersectingElementShape, rec:operatedByShape,
        rec:ownedByShape.
rec:ArchitectureArea
    a owl:Class, sh:NodeShape;
    rdfs:comment
        "Describes business-relevant area measurements typically associated with architected spaces. As the exact requirements on these measurements will vary from case to case or jurisdiction to jurisdiction, subclassing and specializing this definition is encouraged."@en;
    rdfs:label "Architecture area"@en, "Architecture area"@sv;
    rdfs:subClassOf rec:Information;
    sh:property rec:grossAreaShape, rec:netAreaShape, rec:rentableAreaShape.
rec:ArchitectureCapacity
    a owl:Class, sh:NodeShape;
    rdfs:comment
        "Describes business-relevant capacity measurements typically associated with architected spaces. As the exact requirements on these measurements will vary from case to case or jurisdiction to jurisdiction, subclassing and specializing this definition is encouraged."@en;
    rdfs:label "Architecture capacity"@en, "Architecture capacity"@sv;
    rdfs:subClassOf rec:Information;
    sh:property rec:maxOccupancyShape, rec:seatingCapacityShape.
