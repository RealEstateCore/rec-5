rec:geometry
    a owl:ObjectProperty;
    rdfs:comment
        "A GeoJSON Geometry representing the position or extent of the asset."@en,
        "Polygon representing the spatial extent of this Space."@en;
    rdfs:label "geometry"@en, "geometry"@sv;
    rdfs:subPropertyOf rec:relationship.
rec:Geometry
    a owl:Class, sh:NodeShape;
    rdfs:label "Geometry"@en, "Geometry"@sv;
    rdfs:subClassOf rec:Information;
    sh:property rec:coordinateSystemShape.
rec:geometryShape
    a sh:PropertyShape;
    sh:class rec:Geometry;
    sh:maxCount 1;
    sh:message
        "Property geometry must reference a valid instance of Geometry. Can have at most one geometry"@en;
    sh:path rec:geometry.
rec:georeference
    a owl:ObjectProperty;
    rdfs:comment
        "A georeference creates a relationship between the local coordinate system used within a building (e.g., measured in meters) and a geographic coordinate system (e.g., lat, long, alt), such that locally placed Spaces can be resolved and rendered in that geographic coordinate system (e.g., for mapping purposes)."@en;
    rdfs:label "georeference"@en, "georeference"@sv;
    rdfs:subPropertyOf rec:relationship.
rec:Georeference
    a owl:Class, sh:NodeShape;
    rdfs:comment
        "A georeference creates a relationship between a local coordinate system into a geographic coordinate system."@en;
    rdfs:label "Georeference"@en, "Georeference"@sv;
    rdfs:subClassOf rec:Information.
rec:georeferenceShape
    a sh:PropertyShape;
    sh:class rec:Georeference;
    sh:maxCount 1;
    sh:message
        "Property georeference must reference a valid instance of Georeference. Can have at most one georeference"@en;
    sh:path rec:georeference.
rec:Geotransform
    a owl:Class, sh:NodeShape;
    rdfs:comment
        "A transform following GDAL's Affine Transform that transforms a local coordinate into a WGS84 coordinate. Created from Ground Control Points (GCP) using GDAL's GCPsToGeotransform method."@en;
    rdfs:label "Geotransform"@en, "Geotransform"@sv;
    rdfs:subClassOf rec:Georeference;
    sh:property
        rec:heightScaleFactorShape, rec:originXShape, rec:originYShape,
        rec:widthScaleFactorShape, rec:xRotationalScaleFactorShape,
        rec:yRotationalScaleFactorShape.
rec:givenName
    a owl:DatatypeProperty;
    rdfs:label "givenName"@en, "givenName"@sv;
    rdfs:range xsd:string.
rec:givenNameShape
a sh:PropertyShape; sh:datatype xsd:string; sh:path rec:givenName.
